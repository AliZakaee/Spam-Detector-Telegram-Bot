# Copy this file to .env and fill in your real values. core/bot.py loads it automatically.

# --- Required ---
# Bot token from @BotFather.
AUTH_TOKEN=123456:your-bot-token-here
# Channel where deleted/flagged messages are logged. Keep the leading '-' (e.g. -1001234567890).
LOGS_CHANNEL_ID=-1001234567890
# Group where admins receive spam-review prompts. Keep the leading '-'.
ADMINS_GROUP_ID=-1001234567890

# --- Optional (sensible defaults applied if unset) ---
# Advertisement link shown to flagged users. Default: https://t.me/ITheEqualizer
AD_LINK=https://t.me/ITheEqualizer
# Public @username (without @) used to build the admin "review message" deep-link.
# Leave blank to omit that button. Example: SomeCoolGroup
GROUP_USERNAME=
# Spam-probability threshold for auto-flagging, between 0 and 1. Default: 0.4
SPAM_THRESHOLD=0.4
