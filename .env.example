# Copy this file to .env and fill in your real values. core/bot.py loads it automatically.

# --- Required ---
# Bot token from @BotFather.
AUTH_TOKEN=123456:your-bot-token-here
# Channel where deleted/flagged messages are logged. Keep the leading '-' (e.g. -1001234567890).
LOGS_CHANNEL_ID=-1001234567890
# Group where admins receive spam-review prompts. Keep the leading '-'.
ADMINS_GROUP_ID=-1001234567890

# --- Classifier ---
# How messages are judged. Default: auto
#   auto      — TypeSafe if TYPESAFE_API_KEY is set, local SVM if model.pkl exists, hybrid if both
#   typesafe  — TypeSafe Jev only (no training). Requires TYPESAFE_API_KEY.
#   svm       — local TF-IDF + SVM only. Requires python train/train.py first.
#   hybrid    — TypeSafe + SVM; either side can flag a message for admin review
CLASSIFIER_BACKEND=auto
# TypeSafe API key from https://console.typesafe.ai — enough to run the bot without training.
TYPESAFE_API_KEY=
# Choice/Score confidence floor for TypeSafe. Below this, the Choice/Score is not acted on
# by itself (Noul hazards can still flag). Default: 0.5
TYPESAFE_CONFIDENCE_FLOOR=0.5
# Spam-probability threshold for auto-flagging, between 0 and 1. Default: 0.4
# Used by the SVM and by TypeSafe Choice/Noul probabilities.
SPAM_THRESHOLD=0.4

# --- Optional (sensible defaults applied if unset) ---
# Advertisement link shown to flagged users. Default: https://t.me/ITheEqualizer
AD_LINK=https://t.me/ITheEqualizer
# Public @username (without @) used to build the admin "review message" deep-link.
# Leave blank to omit that button. Example: SomeCoolGroup
GROUP_USERNAME=
